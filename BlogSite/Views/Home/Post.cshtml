@model Post
@using System.Web

<style>
    .article-body img {
        max-width: 100%;
        height: auto;
        border-radius: 4px;
        margin: 15px 0;
    }

    .article-body p {
        margin-bottom: 1.5em;
    }

    .article-body blockquote {
        border-left: 5px solid #000;
        padding: 10px 20px;
        background: #f9f9f9;
        font-style: italic;
    }
</style>

<div class="w3-col l8 s12">
    <div class="w3-card-4 w3-margin w3-white">

        <div style="width: 100%; max-height: 450px; overflow: hidden;">
            <img src="~/Images/@Model.Image"
                 alt="@Model.Title"
                 style="width: 100%; height: auto; min-height: 300px; object-fit: cover;">
        </div>

        <div class="w3-container w3-padding-large">
            <div class="w3-center w3-padding-32">
                <h1 class="w3-xxlarge" style="font-weight: 800; letter-spacing: -1px;">@Model.Title</h1>
                <h4 class="w3-text-grey w3-wide" style="font-size: 1.2em;">@Model.SubTitle</h4>

                <div class="w3-padding-16">
                    <span class="w3-tag w3-light-grey">Published on @Model.Date</span>
                </div>
            </div>

            <hr style="width: 60px; border: 3px solid #000; margin: auto;" class="w3-round">

            <div class="w3-padding-32 article-body" style="font-size: 18px; line-height: 1.8; color: #333;">
                @Html.Raw(HttpUtility.HtmlDecode(Model.Content))
            </div>

            <div class="w3-container w3-padding-24 w3-light-grey w3-margin-top">
                <div class="w3-row">
                    <div class="w3-col m12">
                        <h5 class="w3-opacity"><b>Enjoyed the read?</b></h5>
                        <p class="w3-small">Share your thoughts on my X page or discuss this post with your network.</p>

                        <div class="w3-margin-top">
                            <a class="w3-button w3-black w3-border w3-padding-large w3-margin-left" href="/Home">
                                <b>&laquo; BACK TO HOME</b>
                            </a>
                            <a class="w3-button w3-blue w3-hover-light-blue w3-padding-large"
                               target="_blank"
                               href="https://twitter.com/intent/tweet?text=I just read '@Model.Title' - Check it out!&url=@(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)">
                                <i class="fa fa-twitter"></i> <b>Share on X</b>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="w3-padding-32"></div>
</div>