@{
}
@model IEnumerable<Post>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bold text-dark m-0">Blog Directory</h2>
            <p class="text-muted small">Manage and view all your published stories</p>
        </div>
        <a asp-action="CreatePost" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>New Post
        </a>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 transition-hover">
                        <div class="position-relative">
                            <img src="~/Images/@item.Image"
                                 class="card-img-top"
                                 alt="@item.Title"
                                 style="height: 200px; object-fit: cover; border-radius: 12px 12px 0 0;">
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title fw-bold text-truncate" title="@item.Title">
                                @item.Title
                            </h5>
                            <p class="card-text text-muted small mb-4" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @item.SubTitle
                            </p>

                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <div class="btn-group">
                                    @* <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary border-0">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger border-0">
                                        <i class="bi bi-trash"></i>
                                    </a> *@
                                </div>
                                <span class="position-absolute top-0 end-0 m-3 badge rounded-pill bg-light text-dark shadow-sm">
                                    @item.Date
                                </span>
                                <a asp-action="ViewDetails" asp-controller="Home" asp-area="Admin" asp-route-id="@item.Id" class="btn transition-hover btn-sm shadow-sm text-primary fw-bold text-decoration-none p-0">
                                    Read More <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-journal-x display-1 text-light"></i>
                <h4 class="mt-3 text-muted">No posts found yet.</h4>
                <a asp-action="CreatePost" class="btn btn-link text-decoration-none">Start writing your first post!</a>
            </div>
        }
    </div>
</div>

<style>
    /* Subtle hover effect for cards */
    .transition-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .transition-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important;
        }
</style>