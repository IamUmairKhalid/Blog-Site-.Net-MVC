@model IEnumerable<Post>
@{
    var totalPosts = Model.Count();
    var lastPostDate = Model.OrderByDescending(p => p.Date).FirstOrDefault()?.Date;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-0 text-dark fw-bold">Admin Control Center</h1>
                <p class="text-muted">Managing <b>@totalPosts</b> active blog entries.</p>
            </div>
            <a asp-area="Admin" asp-controller="Home" asp-action="CreatePost" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg"></i> New Post
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="m-0 fw-bold text-primary">Content Inventory</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th>Post Title</th>
                                    <th>Created Date</th>
                                    <th class="text-end">Management</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var post in Model.Take(10))
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">@post.Title</div>
                                            <small class="text-muted">@post.Slug</small>
                                        </td>
                                        <td>@DateTime.Parse(post.Date).ToShortDateString()</td>
                                        <td class="text-end">
                                            <div class="btn-group">
                                                <a asp-action="ViewDetails" asp-controller="Home" asp-area="Admin" asp-route-id="@post.Id" class="btn transition-hover btn-sm shadow-sm text-primary fw-bold text-decoration-none p-0">
                                                    Read More <i class="bi bi-arrow-right"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h6 class="fw-bold text-muted text-uppercase small mb-3">System Snapshot</h6>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Status:</span>
                        <span class="badge bg-success">Online</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Database:</span>
                        <span class="text-dark fw-bold">Connected</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Last Update:</span>
                        <span class="text-dark fw-bold">@DateTime.Parse(lastPostDate).ToShortDateString()</span>
                    </div>
                </div>
            </div>

            <div class="card border-0 bg-primary text-white shadow-sm mb-4">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-person-circle fs-1"></i>
                    <h5 class="mt-2">My Profile</h5>
                    <p class="small opacity-75">Update your password and profile picture.</p>
                    <a asp-area="Admin" asp-controller="Home" asp-action="ProfileView" class="btn btn-light btn-sm w-100 fw-bold">Edit Profile</a>
                </div>
            </div>

            <div class="list-group shadow-sm border-0">
                <a href="/" target="_blank" class="list-group-item list-group-item-action py-3">
                    <i class="bi bi-box-arrow-up-right me-2"></i> View Live Website
                </a>
                <a asp-area="Admin" asp-controller="Home" asp-action="ViewPosts" class="list-group-item list-group-item-action py-3">
                    <i class="bi bi-journal-text me-2"></i> Full Post Library
                </a>
            </div>
        </div>
    </div>
</div>